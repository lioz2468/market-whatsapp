# ── Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp recipient ─────────────────────────────────
# Individual: +972501234567
# Group (Green API): 1234567890-1234567890@g.us
WHATSAPP_TO=+972501234567

# Separate target for the morning brief group (send_morning_brief.py).
# Falls back to WHATSAPP_TO above if left unset.
# MORNING_BRIEF_TO=1234567890-1234567890@g.us

# ── Twilio (אופציה A) ──────────────────────────────────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# שליחה ישירה ממספר (Sandbox: +14155238886 | Production: המספר שאושר)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Production: Content Template מאושר (HX...) — נדרש לפתיחת שיחה ב-WhatsApp Business
# הטמפלייט צריך להכיל משתנה אחד {{1}} שמקבל את טקסט ההודעה.
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production: Messaging Service (MG...) — אלטרנטיבה ל-TWILIO_WHATSAPP_FROM
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Green API (אופציה B) ──────────────────────────────
GREEN_API_INSTANCE=1234567890
GREEN_API_TOKEN=your_token_here

# ── X (Twitter) API v2 — @wallstengine feed ────────────
# Leave empty to skip the Twitter feed source silently.
X_BEARER_TOKEN=

# ── Optional overrides ────────────────────────────────
# DEFAULT_PROVIDER=twilio          # twilio | green
# MIN_IMPORTANCE_SCORE=6           # 1-10, only send if >= this
# MAX_CONCURRENT_CLAUDE=5
# DIGEST_HOURS=12                  # lookback window for --morning-digest
# CLAUDE_MODEL=claude-sonnet-4-0

# ── Email digest pool overrides (--collect-email-pool, optional) ──────────
# EMAIL_LOOKBACK_HOURS=24           # how far back to pull world + business/tech items
# MIN_WORLD_IMPORTANCE_SCORE=5      # 1-10, only keep world articles >= this
# MAX_WORLD_ARTICLES=10             # cap on world articles written to email_digest.json

# ── Responder (רב מסר) — newsletter send (send_newsletter.py) ─────────────
# Two DIFFERENT Responder APIs, two different credential sets — see the
# comment in config.py for why. V1 is the only one that can send a message.

# V1 (message create/test/send) — NOT in the self-service screen, only from
# Responder support: 03-7177777. Ask for API V1 (c_key/c_secret/u_key/u_secret).
RESPONDER_C_KEY=
RESPONDER_C_SECRET=
RESPONDER_U_KEY=
RESPONDER_U_SECRET=
# Find this by running: python send_newsletter.py --list-lists (V1) or
# --list-lists-v2 (V2, works with the credentials below — no phone call needed)
RESPONDER_LIST_ID=

# V2.0 (self-service) — Settings → "חיבורים חיצוניים (API)" → "מפתח כללי
# לחשבון" in the Responder account. Only used here to verify credentials /
# look up RESPONDER_LIST_ID — V2.0 has no message-sending endpoint.
RESPONDER_V2_CLIENT_ID=
RESPONDER_V2_CLIENT_SECRET=
RESPONDER_V2_USER_TOKEN=

# Where test sends go before anything reaches the real list (--send-live).
# NEWSLETTER_TEST_EMAIL=lioz2468@gmail.com
# NEWSLETTER_TEST_NAME=ליוז

# Second opt-in required (on top of --send-live) before a real send to the
# whole list is allowed. Leave unset/false until you've verified test sends.
# NEWSLETTER_ALLOW_LIVE_SEND=false
